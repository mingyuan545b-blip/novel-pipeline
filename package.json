{
  "name": "novel-pipeline",
  "version": "2.0.0",
  "private": true,
  "description": "AI Novel Creation Pipeline",
  "scripts": {
    "check": "node scripts/health-check.js",
    "check:all": "node scripts/health-check.js && node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --verbose",
    "start": "node scripts/serverStart.js --start",
    "stop": "node scripts/serverStart.js --stop",
    "restart": "node scripts/serverStart.js --restart",
    "server:status": "node scripts/serverStart.js --status",
    "kill:port": "node scripts/killPort.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --verbose",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --verbose --testTimeout=120000",
    "migrate": "node server/db/migrate.js migrate",
    "migrate:verify": "node server/db/migrate.js verify",
    "migrate:backup": "node server/db/migrate.js backup",
    "backup": "node scripts/pgBackup.js",
    "backup:dry": "node scripts/pgBackup.js --dry-run",
    "backup:list": "node scripts/pgBackup.js --list",
    "backup:verify": "node scripts/pgBackup.js --verify",
    "backup:restore-test": "node scripts/pgBackup.js --restore-test",
    "lint": "npx eslint server/services/ server/core/ server/config/ server/middleware/ server/shared/ --ext .js",
    "lint:fix": "npx eslint server/services/ server/core/ server/config/ server/middleware/ server/shared/ --ext .js --fix",
    "test:smoke": "node server/scripts/smoke-test.js",
    "test:e2e": "node server/scripts/e2e-test.js",
    "test:integrity": "node server/scripts/data-integrity-test.js",
    "test:errors": "node server/scripts/comprehensiveStartupVerify.js",
    "test:all": "node server/scripts/smoke-test.js && node server/scripts/e2e-test.js && node server/scripts/data-integrity-test.js",
    "test:e2e-smoke": "node -e \"process.env.NODE_PATH='server';require('./tests/e2e/e2eSmokeTest')\"",
    "test:e2e-api": "node tests/e2e/e2eApiTest.js",
    "ci:check": "node -e \"process.env.NODE_PATH='server';require('./tests/e2e/e2eSmokeTest')\" && node scripts/importAudit.js && node scripts/verifyMaterialMigration.js && node scripts/verifyConstraintChain.js && node scripts/verifyProjectStandards.js && node scripts/verifyGuardChain.js && node scripts/verifyAuditConsistency.js && node scripts/verifyWordConfigSchema.js && node scripts/verifyTargetChaptersSchema.js && node scripts/verifyStyleProfileSchema.js && node scripts/verifyApiContract.js && node scripts/verifyChapterIntentsSchema.js && node scripts/verifyGenrePluginConsistency.js && node scripts/verifyCascadeDelete.js && node scripts/verifyFrontendComplexity.js && node scripts/verifyRouteRegistration.js && node scripts/auditApiRegistry.js && node scripts/audit-vocabulary-consistency.js && node scripts/audit-material-shape.js && node scripts/verifyMaterialAssemblyEntry.js && node scripts/verifyDataSourceConsistency.js && node scripts/verifyDocFreshness.js && node scripts/verifyErrorTraceability.js && node scripts/deepAudit.js && npx eslint server/ --ext .js --max-warnings=0 && npm run coverage:check && node scripts/perfBaselineCheck.js && node scripts/audit-leak-fix.js --ci",
    "audit:api": "node scripts/apiLiveAudit.js",
    "audit:api-registry": "node scripts/auditApiRegistry.js",
    "audit:imports": "node scripts/importAudit.js && node scripts/frontendImportAudit.js",
    "audit:dead": "node scripts/deadCodeAudit.js",
    "audit:hardcode": "node scripts/audit-hardcode.js",
    "audit:vocabulary": "node scripts/audit-vocabulary-consistency.js",
    "audit:material-shape": "node scripts/audit-material-shape.js",
    "gen:chapter-status": "node scripts/generateChapterStatusConstants.js",
    "audit:cascade": "node scripts/audit-cascade-delete.js --ci",
    "audit:doc-sync": "node scripts/audit-doc-sync.js",
    "audit:config-test-sync": "node scripts/audit-config-test-sync.js",
    "audit:leak-fix": "node scripts/audit-leak-fix.js --full",
    "audit:perf-baseline": "node scripts/perfBaselineCheck.js",
    "audit:all": "node scripts/importAudit.js && node scripts/frontendImportAudit.js && node scripts/deadCodeAudit.js && node scripts/audit-hardcode.js && node scripts/audit-cascade-delete.js --ci && node scripts/audit-doc-sync.js && node scripts/audit-config-test-sync.js && node scripts/audit-leak-fix.js --full",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --coverage",
    "coverage:summary": "node scripts/coverage-summary.js",
    "coverage:check": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --coverage --ci",
    "verify:migration": "node scripts/verifyMaterialMigration.js",
    "verify:constraint": "node scripts/verifyConstraintChain.js",
    "verify:all": "node scripts/verifyMaterialMigration.js && node scripts/verifyConstraintChain.js && node scripts/verifyRegistryConsistency.js",
    "prepare": "husky .githooks",
    "test:mutation": "cross-env NODE_OPTIONS=--experimental-vm-modules stryker run",
    "test:mutation:smoke": "cross-env NODE_OPTIONS=--experimental-vm-modules stryker run --mutate server/services/validateQuotes.js",
    "typecheck:js": "tsc -p tsconfig.checkjs.json",
    "lint:tests": "npx eslint tests --ext .js --max-warnings=0",
    "audit:security": "npm audit --audit-level=high --omit=dev --registry=https://registry.npmjs.org",
    "audit:secrets": "gitleaks detect --source . --verbose",
    "docs:lint": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\""
  },
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "js-yaml": "^5.2.0",
    "pg": "^8.21.0",
    "sql.js": "^1.11.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@djankies/vitest-mcp": "^0.5.1",
    "@eslint/mcp": "^0.3.6",
    "@modelcontextprotocol/server-postgres": "^0.6.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.9",
    "chrome-devtools-mcp": "^1.11.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "^4.10.2",
    "gpt-tokenizer": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsonrepair": "^3.15.0",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.23.3",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "server/**/*.js": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "scripts/**/*.js": [
      "eslint --max-warnings=0"
    ]
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
