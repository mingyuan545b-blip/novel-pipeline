{
  "name": "novel-pipeline",
  "version": "2.0.0",
  "private": true,
  "description": "AI Novel Creation Pipeline",
  "scripts": {
    "check": "node scripts/health-check.js",
    "check:all": "node scripts/health-check.js && node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --verbose",
    "start": "node server/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --verbose",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --verbose --testTimeout=120000",
    "migrate": "node server/db/migrate.js migrate",
    "migrate:verify": "node server/db/migrate.js verify",
    "migrate:backup": "node server/db/migrate.js backup"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "sql.js": "^1.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
