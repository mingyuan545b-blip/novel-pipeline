# ============================================
# Novel-Pipeline 环境配置
# ============================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改标记为 [必填] 的变量
# 3. 建议设置所有标记为 [推荐] 的变量
# ============================================

# --------------------------------------------
# 服务器配置
# --------------------------------------------
# [必填] 服务器端口
PORT=3001

# --------------------------------------------
# 安全配置 [强烈推荐]
# --------------------------------------------
# [必填] API认证密钥
# 作用：用于前后端API通信认证
# 要求：至少16字符的随机字符串
# 生成方法：openssl rand -hex 16
# 注意：修改后所有已登录用户需重新登录
REQUEST_SECRET=change-this-to-a-strong-random-secret-at-least-16-chars

# [必填] 加密密钥
# 作用：用于API Key加密存储
# 要求：至少32字符的随机字符串
# 生成方法：openssl rand -hex 16
# 注意：未配置时API Key将以明文存储
ENCRYPTION_SECRET=change-this-to-a-strong-encryption-secret-at-least-32-chars

# [推荐] CORS允许来源
# 作用：限制允许访问API的域名
# 格式：逗号分隔的URL列表
# 注意：生产环境必须配置，未配置时默认允许localhost
# CORS_ORIGINS=http://yourdomain.com,http://www.yourdomain.com

# --------------------------------------------
# LLM API配置 [必填 - 至少配置一个]
# --------------------------------------------

# 阿里云通义配置
# [必填-如使用] 阿里云API密钥
ALIYUN_CODING_API_KEY=your-aliyun-api-key-here
# [必填-如使用] 阿里云模型名称
ALIYUN_CODING_MODEL=qwen3.6-plus

# DeepSeek配置
# [必填-如使用] DeepSeek API密钥
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# [推荐] DeepSeek API地址（默认官方地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# [必填-如使用] DeepSeek模型名称
DEEPSEEK_MODEL=deepseek-chat

# 默认LLM提供商
# 选项：aliyunCoding, deepseek, siliconflow, zhipu, moonshot
LLM_PROVIDER=aliyunCoding

# --------------------------------------------
# 数据库配置 [可选]
# --------------------------------------------
# [可选] 是否使用PostgreSQL
# true: 使用PostgreSQL（生产环境推荐）
# false: 使用JSON文件存储（开发环境）
USE_PG=true

# [必填-如USE_PG=true] PostgreSQL连接字符串
DATABASE_URL=postgresql://postgres@localhost:5432/novel_pipeline

# --------------------------------------------
# 日志配置 [可选]
# --------------------------------------------
# [可选] 日志级别: debug, info, warn, error
# 默认: info
# LOG_LEVEL=info

# --------------------------------------------
# 前端配置 (client/.env)
# --------------------------------------------
# 前端配置请单独在 client/.env 中设置
# 主要变量：VITE_REQUEST_SECRET
