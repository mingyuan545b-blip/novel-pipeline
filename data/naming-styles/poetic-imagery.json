{
    "id": "poetic-imagery",
    "label": "古风意境派",
    "tag": "墓王之王风",
    "description": "姓+名=一幅画/一句诗，名字本身就是意境。骆时秋=骆行时值深秋，楼满风=楼满风声，千月辰=千月之辰，寒千落=寒意千落",
    "corePrinciple": "姓名即画面，读名如读诗。姓与名必须形成完整意境句，不是随便拼两个字",
    "surnamePool": {
        "cold": ["骆","楼","寒","墨","萧","楚","沈","顾","慕","容","叶","凌","苏","柳","白","秦","夜","云","风","江"],
        "compound": ["千月","百里","上官","慕容","南宫","东方","西门","独孤","令狐","诸葛","司马","轩辕","皇甫","公孙"]
    },
    "givenNamePatterns": [
        {
            "pattern": "时令+意象",
            "examples": ["时秋","暮春","初雪","晚霜","半夏","惊蛰","谷雨","白露"],
            "rule": "取节气/时令词+自然意象，形成时间画面"
        },
        {
            "pattern": "动词+名词=画面",
            "examples": ["满风","落花","听雨","望月","踏雪","寻梅","追风","破晓"],
            "rule": "一个动作+一个对象，形成动态画面"
        },
        {
            "pattern": "形容词+名词=氛围",
            "examples": ["清寒","孤鸿","寂月","幽兰","冷霜","素衣","苍穹","碧落"],
            "rule": "氛围词+意象词，形成情绪画面"
        },
        {
            "pattern": "数量+意象=气势",
            "examples": ["千落","万寂","九霄","一尘","三千","百川","无双","无极"],
            "rule": "数词+意象，形成宏大或极简的画面"
        }
    ],
    "combinationRules": [
        "姓+名必须能连读成一句有画面的话",
        "骆时秋→骆行时值秋，楼满风→楼满风声，寒千落→寒意千落",
        "避免姓和名的意象冲突（如'火热'配'寒冰'）",
        "平仄交替，朗朗上口：仄平平、平仄仄等",
        "名字读出来要有余韵，不能太直白"
    ],
    "forbiddenPatterns": [
        "张伟/李明/王芳等烂大街名字",
        "紫萱/若熙/梦琪等古风烂大街",
        "姓氏用常见大姓（张王李赵刘陈杨）",
        "名字用纯形容词无画面（美丽/帅气）"
    ],
    "exampleNames": [
        {"name":"骆时秋","解析":"骆行时值深秋，萧瑟之意"},
        {"name":"楼满风","解析":"楼满风声，高处不胜寒"},
        {"name":"千月辰","解析":"千月之辰，时间永恒"},
        {"name":"寒千落","解析":"寒意千落，万物凋零"},
        {"name":"墨听雨","解析":"墨色中听雨，文人孤寂"},
        {"name":"萧踏雪","解析":"萧然踏雪，独行天地"},
        {"name":"慕清寒","解析":"慕清寒之境，高洁不群"},
        {"name":"沈破晓","解析":"沈沉至暗，终破黎明"}
    ],
    "applicableGenres": ["高武","玄幻","仙侠","武侠","古风","修仙"],
    "intensity": {"light":"偶尔用意境名","medium":"主要角色用意境名","heavy":"全员意境名，连路人都有画面"}
}
