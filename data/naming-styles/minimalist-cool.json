{
    "id": "minimalist-cool",
    "label": "极简单字派",
    "tag": "高冷禁欲风",
    "description": "单姓+单字名，冷到骨子里。沈渡、顾衍、陆离、裴寂——一个字就够了",
    "corePrinciple": "少即是多，一个字比两个字更有力量。名字越短，人越冷，距离感越强",
    "surnamePool": {
        "cold": ["沈","顾","陆","裴","傅","霍","谢","魏","萧","楚","温","段","江","晏","薄","迟","郁","司","封","越"],
        "rare": ["澹台","百里","闻人","微生","公冶","太叔","端木","司空"]
    },
    "givenNamePatterns": [
        {
            "pattern": "动词型=行动力",
            "examples": ["渡","衍","临","归","破","斩","决","弃"],
            "rule": "一个动词=一种决断，名字就是行动"
        },
        {
            "pattern": "状态型=存在感",
            "examples": ["寂","离","寒","凛","默","渊","尘","烬"],
            "rule": "一种状态=一种气质，名字就是氛围"
        },
        {
            "pattern": "意象型=画面感",
            "examples": ["夜","昼","霜","雪","月","星","岚","霓"],
            "rule": "一个意象=一幅画，名字就是视觉"
        },
        {
            "pattern": "否定型=超脱感",
            "examples": ["无","非","莫","勿","空","虚","绝","灭"],
            "rule": "否定=超越，名字就是态度"
        }
    ],
    "combinationRules": [
        "姓+名必须一个字，绝不多一个字",
        "姓和名不能同声调，要有起伏（沈渡3-4声，顾衍4-3声）",
        "名字读出来要有'收'的感觉，不能拖（渡/寂/寒都短促）",
        "避免谐音歧义（魏寂=畏忌，段寂=断寂可以）"
    ],
    "forbiddenPatterns": [
        "双字名破坏极简感（沈渡之/顾衍清）",
        "太柔的字（柔/婉/婷）不适合冷感",
        "常见名字（沈明/顾华/陆强）太普通"
    ],
    "exampleNames": [
        {"name":"沈渡","解析":"渡河渡劫，一渡了之"},
        {"name":"顾衍","解析":"衍=推演延伸，冷静推演一切"},
        {"name":"陆离","解析":"陆离光怪，超脱世俗"},
        {"name":"裴寂","解析":"寂=万籁俱寂，冷到极致"},
        {"name":"薄寒","解析":"薄薄寒意，拒人千里"},
        {"name":"晏无","解析":"晏=晚，无=空，晚来无所有"}
    ],
    "applicableGenres": ["都市","玄幻","高武","仙侠","悬疑","权谋"],
    "intensity": {"light":"主角单字名","medium":"主要角色单字名","heavy":"全员单字名，连势力名都极简"}
}
