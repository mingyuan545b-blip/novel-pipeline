# Preserve existing line-ending behavior (core.autocrlf=true on this machine).
# Do not force eol=lf here; it would create a mass-renormalization diff.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
