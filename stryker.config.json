{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.stryker.config.js",
    "enableFindRelatedTests": true
  },
  "mutate": [
    "server/services/validateHighlights.js",
    "server/services/validateQuotes.js",
    "server/services/craftQualitySpec.js",
    "server/services/pipeline/pipelineHelpers/pipelinePostApproval.js",
    "server/services/pipeline/steps/materialItemProcessor.js"
  ],
  "ignorePatterns": [
    "tests/unit/vocabularyConsistency.test.js",
    "docs",
    "output",
    "backups",
    "logs",
    "coverage",
    "test-screenshots"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 40
  },
  "reporters": ["clear-text", "progress", "json"],
  "concurrency": 2,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp"
}
