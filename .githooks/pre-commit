#!/bin/bash
# git pre-commit hook - 铁律违反检测
#
# 安装方法（一次性）：
#   git config core.hooksPath .githooks
#
# 作用：commit前自动扫描暂存区，检测硬编码+PS语法
# 违反则拦截commit

echo "[PRE-COMMIT] 铁律违反检测..."

# 跑铁律检测脚本（pre-commit模式，只扫暂存区）
node scripts/audit-iron-law.js --pre-commit

if [ $? -ne 0 ]; then
    echo ""
    echo "[PRE-COMMIT] ❌ commit已拦截，请修复违反项后再提交"
    echo "[PRE-COMMIT] 修复指南："
    echo "  - P0-4 硬编码敏感信息 → 移到.env或配置文件"
    echo "  - P1-Q1 硬编码业务值 → 用 chapterStatus.js 的 STATUS_VALUES 常量"
    echo "  - P2-B1 PowerShell语法 → 改用node脚本"
    exit 1
fi

echo "[PRE-COMMIT] ✓ 铁律检测通过，允许commit"
exit 0
