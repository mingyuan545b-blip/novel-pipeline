#!/bin/bash
# 统一 pre-commit 质量门禁（单一入口，消除 husky/.githooks 双钩子互斥）
# 顺序：铁律(快) -> lint-staged -> 硬编码审计 -> 级联删除 -> 项目标准
# 规则定义统一在 scripts/lib/ironLawRules.js，由 --self-check 保证互斥一致性

echo "[PRE-COMMIT] 铁律违反检测（场景化分支+共享规则）..."
node scripts/audit-iron-law.js --pre-commit || exit 1

echo "[PRE-COMMIT] lint-staged（ESLint --max-warnings=0）..."
npx lint-staged || exit 1

echo "[PRE-COMMIT] 硬编码审计（共享规则）..."
node scripts/audit-hardcode.js || exit 1

echo "[PRE-COMMIT] 级联删除注册检查..."
node scripts/audit-cascade-delete.js --ci || exit 1

echo "[PRE-COMMIT] 项目标准校验..."
node scripts/verifyProjectStandards.js || exit 1

echo "[PRE-COMMIT] ✅ 全部检查通过"
exit 0
